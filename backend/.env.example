# Connection string do PostgreSQL (Neon, Supabase ou local)
DATABASE_URL="postgresql://usuario:senha@localhost:5432/point_talentos?schema=public"

# Credenciais criadas no Google Cloud Console (OAuth 2.0)
GOOGLE_CLIENT_ID="seu-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="seu-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:3000/auth/google/callback"

# Segredo usado para assinar os tokens JWT (qualquer texto longo e aleatorio)
JWT_SECRET="troque-este-valor-por-uma-string-aleatoria-bem-grande"
JWT_EXPIRES_IN="7d"

# URL do frontend, usada para redirecionar apos o login
FRONTEND_URL="http://localhost:5173"

# E-mails que terao automaticamente o papel de administrador ao fazer login
ADMIN_EMAILS="seuemail@gmail.com"

PORT=3000
